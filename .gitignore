```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
target/

# TypeScript/JavaScript specific
*.js.map
*.tsbuildinfo
.cache/

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
coverage/
.nyc_output/
istanbul/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Python artifacts (if any Python in project)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Compiled binaries
*.exe
*.dll
*.so
*.dylib

# Compressed archives
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
```